{
  "name": "portolan",
  "version": "0.0.0",
  "private": true,
  "description": "Read-only Docker Swarm topology map.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "harness"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --build && tsc --project tsconfig.tools.json",
    "typecheck:clean": "tsc --build --clean && npm run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:determinism": "vitest run --passWithNoTests determinism",
    "licences": "node scripts/check-licences.mjs",
    "tokens:css": "node scripts/generate-tokens-css.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
