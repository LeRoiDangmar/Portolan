{
  "$comment": "`./x.ts` import specifiers, as in packages/model: `rewriteRelativeImportExtensions` turns them into `./x.js` on emit, so dist/ is still ordinary ESM. Tests are excluded from the build and typechecked by tsconfig.tools.json instead.",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "paths": {
      "@portolan/model": ["../../packages/model/src/index.ts"],
      "@portolan/tokens": ["../../packages/tokens/src/index.ts"],
      "@portolan/*": ["../../boundary/there-is-no-arrow-back-up.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    {
      "path": "../../packages/model"
    },
    {
      "path": "../../packages/tokens"
    }
  ]
}
