{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "lib": ["es2024", "dom", "dom.iterable"],
    "types": [],
    "paths": {
      "@portolan/model": ["../../packages/model/src/index.ts"],
      "@portolan/layout": ["../../packages/layout/src/index.ts"],
      "@portolan/tokens": ["../../packages/tokens/src/index.ts"],
      "@portolan/view-state": ["../../packages/view-state/src/index.ts"],
      "@portolan/*": ["../../boundary/there-is-no-arrow-back-up.ts"]
    }
  },
  "include": ["src"],
  "references": [
    {
      "path": "../../packages/model"
    },
    {
      "path": "../../packages/layout"
    },
    {
      "path": "../../packages/tokens"
    },
    {
      "path": "../../packages/view-state"
    }
  ]
}
