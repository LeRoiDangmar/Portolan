#!/bin/sh
# Enforce Conventional Commits — see CLAUDE.md (Git workflow).
# Bypass in exceptional cases with: git commit --no-verify
. "$(dirname "$0")/_common.sh"

msg_file="$1"

# First non-comment, non-blank line = the subject.
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n1)

# Allow git-generated merge/revert/fixup/squash subjects.
case "$subject" in
  "Merge "*|"Revert "*|fixup!*|squash!*) exit 0 ;;
esac

# <type>(<optional-scope>)<optional-!>: <description>
pattern="^($(hook_types_alt))(\([a-z0-9._/-]+\))?!?: .+"
if printf '%s' "$subject" | grep -Eq "$pattern"; then
  len=${#subject}
  if [ "$len" -gt 72 ]; then
    echo "⚠️  commit-msg: subject is ${len} chars (>72) — consider shortening." >&2
  fi
  exit 0
fi

{
  echo "✖ commit-msg: subject is not a Conventional Commit."
  echo "  Got:     ${subject:-<empty>}"
  echo "  Format:  <type>(<optional-scope>): <imperative description>"
  echo "  Types:   $(hook_types)"
  echo "  Example: feat(admin): add the company picker to the app form"
  echo "  Bypass:  git commit --no-verify"
} >&2
exit 1
